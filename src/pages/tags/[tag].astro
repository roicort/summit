---
import { getCollection } from 'astro:content';
import Card from '../../components/Card.astro';
import PageLayout from '../../layouts/PageLayout.astro';
import { getSite } from '../../utils/consts';
import { slugify, withBase } from '../../utils/slugify';

const site = await getSite();

export async function getStaticPaths() {
	const conferences = (await getCollection('conferences')).filter((conference) => conference.id.startsWith('en/'));
	const tags = new Map<string, string>();

	conferences.forEach((conference) => {
		(conference.data.tags ?? []).forEach((tag) => {
			tags.set(slugify(tag), tag);
		});
	});

	return Array.from(tags.entries()).map(([slug, label]) => ({
		params: { tag: slug },
		props: { tagLabel: label },
	}));
}

interface Props {
	tagLabel: string;
}

const { tagLabel } = Astro.props as Props;
const tagParam = Astro.params.tag ?? '';
const conferences = (await getCollection('conferences'))
	.filter((conference) => conference.id.startsWith('en/'))
	.filter((conference) =>
	(conference.data.tags ?? []).some((tag) => slugify(tag) === tagParam),
);

conferences.sort((a, b) => a.data.date.valueOf() - b.data.date.valueOf());
---

<PageLayout title={`${tagLabel} · Topics · ${site.title}`} description={`Conferences tagged ${tagLabel}`}>
	<section class="content-shell py-12 space-y-6">
		<header class="space-y-2">
			<p class="text-sm uppercase tracking-[0.3em] text-muted">Topic</p>
			<h1 class="text-3xl font-semibold text-ink">{tagLabel}</h1>
			<p class="text-muted">Conferences in this topic.</p>
		</header>

		{conferences.length === 0 ? (
			<p class="text-muted">There are no conferences in this topic.</p>
		) : (
			<div class="grid grid-cols-1 md:grid-cols-2 gap-6 lg:gap-8">
				{conferences.map((conference) => {
					const slug = conference.id.replace(/^en\//, '');
					return (
					<Card
						title={conference.data.title}
						href={withBase(`/conferences/${slug}/`)}
						description={conference.data.description}
						date={conference.data.date}
						image={conference.data.heroImage}
						imageAlt={conference.data.title}
					/>
					);
				})}
			</div>
		)}
	</section>
</PageLayout>
