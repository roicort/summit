---
import PageLayout from '../layouts/PageLayout.astro';
import Hero from '../components/Hero.astro';
import ConferenceList from '../components/ConferenceList.astro';
import Numbers from '../components/Numbers.astro';
import About from '../components/About.astro';
import { getCollection } from 'astro:content';
import { getSite } from '../utils/consts';
const site = await getSite();
const conferences = (await getCollection('conferences')).filter((conference) => conference.id.startsWith('en/'));
const speakerCount = (await getCollection('speakers')).filter((speaker) => speaker.id.startsWith('en/')).length;
const dayCount = new Set(conferences.map((conference) => conference.data.day)).size;
---

<PageLayout
	title={site.title}
>
	<Hero
			eyebrow="Summit 2026 · Earth and climate"
			title="Ideas for a livable planet."
			description="Three days of science, stories, and practical action for a changing climate."
		actions={[
			{ label: 'Explore the program', href: '/conferences' },
			{ label: 'View the schedule', href: '/schedule' },
		]}
	/>

	<About lang="en" />

	<Numbers
			eyebrow="Summit 2026"
			title="The gathering at a glance"
			copy="Three days of talks, workshops, and conversations about the future of our shared home."
		stats={[
			{ label: 'Sessions', value: String(conferences.length), description: 'Research, lived experience, and practical climate action.' },
			{ label: 'Speakers', value: String(speakerCount), description: 'Scientists, organizers, and practitioners in conversation.' },
			{ label: 'Days', value: String(dayCount), description: 'A shared space for learning, listening, and acting.' },
		]}
	/>

	<ConferenceList
		heading="Conferences"
		limit={3}
		viewAllHref="/conferences"
	/>

</PageLayout>
