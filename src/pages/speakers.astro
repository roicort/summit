---
import PageLayout from '../layouts/PageLayout.astro';
import Speakers from '../components/Speakers.astro';
---

<PageLayout title="Speakers" description="Meet the people sharing their work and ideas at Summit.">
	<section class="content-shell py-12 space-y-8">
		<header class="space-y-3 max-w-3xl">
			<p class="eyebrow m-0">Speakers</p>
			<h1 class="text-3xl sm:text-4xl font-semibold leading-tight text-ink m-0">People with something to share</h1>
			<p class="text-base text-muted m-0">Meet the practitioners, thinkers, and makers joining us on stage.</p>
		</header>
		<Speakers />
	</section>
</PageLayout>