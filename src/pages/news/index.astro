---
import { getCollection } from 'astro:content';
import PageLayout from '../../layouts/PageLayout.astro';
import { getSite } from '../../utils/consts';
import { withBase } from '../../utils/slugify';

const news = (await getCollection('news'))
	.filter((entry) => entry.id.startsWith('en/'))
	.sort((first, second) => second.data.pubDate.valueOf() - first.data.pubDate.valueOf());
const site = await getSite();
---

<PageLayout title={`News · ${site.title}`} description="Updates from Summit.">
	<section class="content-shell py-12 space-y-10">
		<header class="max-w-3xl space-y-2">
			<p class="eyebrow m-0">News</p>
			<h1 class="m-0 text-4xl font-semibold leading-tight text-ink">News from Summit</h1>
			<p class="m-0 text-muted">Program updates, announcements, and practical details for the gathering.</p>
		</header>
		{news.length === 0 ? <p class="text-muted">No news has been published yet.</p> : (
			<div class="border-y border-border">
				{news.map((entry) => {
					const slug = entry.id.replace(/^en\//, '');
					return <a class="group grid gap-3 border-b border-border py-6 last:border-b-0 md:grid-cols-[11rem_minmax(0,1fr)] md:gap-6" href={withBase(`/news/${slug}/`)}>
						<time class="text-sm text-muted" datetime={entry.data.pubDate.toISOString()}>{entry.data.pubDate.toLocaleDateString('en-US', { day: 'numeric', month: 'long', year: 'numeric', timeZone: 'UTC' })}</time>
						<div><h2 class="m-0 text-xl font-semibold text-ink transition-colors group-hover:opacity-65">{entry.data.title}</h2><p class="mt-2 mb-0 text-muted">{entry.data.description}</p></div>
					</a>;
				})}
			</div>
		)}
	</section>
</PageLayout>