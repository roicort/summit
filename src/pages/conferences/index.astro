---
import ConferenceList from '../../components/ConferenceList.astro';
import PageLayout from '../../layouts/PageLayout.astro';
---

<PageLayout title="Conferences" description="The full Summit conference program.">
	<section class="content-shell py-12 space-y-8">
		<header class="space-y-3 max-w-3xl">
			<p class="eyebrow m-0">Summit 2026</p>
			<h1 class="text-3xl sm:text-4xl font-semibold leading-tight text-ink m-0">The conference program</h1>
			<p class="text-base text-muted m-0">Every conference, in the order it happens.</p>
		</header>
		<ConferenceList />
	</section>
</PageLayout>