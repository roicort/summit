---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import ConferenceList from '../../components/ConferenceList.astro';
import Numbers from '../../components/Numbers.astro';
import About from '../../components/About.astro';
import { getCollection } from 'astro:content';
import { getSite } from '../../utils/consts';
const site = await getSite();
const conferences = (await getCollection('conferences')).filter((conference) => conference.id.startsWith('fr/'));
const speakerCount = (await getCollection('speakers')).filter((speaker) => speaker.id.startsWith('fr/')).length;
const dayCount = new Set(conferences.map((conference) => conference.data.day)).size;
---

<PageLayout
	title={site.title}
>
	<Hero
			eyebrow="Summit 2026 · Terre et climat"
			title="Des idees pour une planete habitable."
			description="Trois jours de science, de recits et d'actions concretes face au changement climatique."
		actions={[
			{ label: 'Decouvrir le programme', href: '/fr/conferences' },
			{ label: 'Voir le programme horaire', href: '/fr/schedule' },
		]}
	/>

	<Numbers
			eyebrow="Summit 2026"
			title="La rencontre en un coup d'oeil"
			copy="Trois jours de talks, d'ateliers et de conversations sur l'avenir de notre maison commune."
		stats={[
			{ label: 'Sessions', value: String(conferences.length), description: 'Recherche, experiences vecues et actions climatiques.' },
			{ label: 'Intervenants', value: String(speakerCount), description: 'Scientifiques, militants et praticiens en conversation.' },
			{ label: 'Jours', value: String(dayCount), description: 'Un espace commun pour apprendre, ecouter et agir.' },
		]}
	/>

	<About lang="fr" />

	<ConferenceList
		heading="Conferences"
		limit={3}
		viewAllHref="/fr/conferences"
	/>

</PageLayout>
