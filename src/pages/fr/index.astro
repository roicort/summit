---
import PageLayout from '../../layouts/PageLayout.astro';
import Hero from '../../components/Hero.astro';
import ConferenceList from '../../components/ConferenceList.astro';
import Numbers from '../../components/Numbers.astro';
import About from '../../components/About.astro';
import { getCollection } from 'astro:content';
import { getSite } from '../../utils/consts';
const site = await getSite();
const conferences = (await getCollection('conferences')).filter((conference) => conference.id.startsWith('fr/'));
const speakerCount = (await getCollection('speakers')).filter((speaker) => speaker.id.startsWith('fr/')).length;
const dayCount = new Set(conferences.map((conference) => conference.data.day)).size;
---

<PageLayout
	title={site.title}
>
	<Hero
		eyebrow="Un boilerplate pour conference"
		title="Une journee d'idees pour faire avancer le web."
		description="Une base Astro pour publier un evenement, son programme de conferences, ses intervenants et son agenda."
		actions={[
			{ label: 'Voir les conferences', href: '/fr/conferences' },
			{ label: 'Voir le programme', href: '/fr/schedule' },
		]}
	/>

	<Numbers
		eyebrow="Summit 2026"
		title="Le rendez-vous en un coup d'oeil"
		copy="Trois jours de conferences, ateliers et conversations au Civic Hall."
		stats={[
			{ label: 'Conferences', value: String(conferences.length), description: 'Idees et sessions pratiques dans le programme.' },
			{ label: 'Intervenants', value: String(speakerCount), description: 'Des praticiens qui partagent leur travail sur scene.' },
			{ label: 'Jours', value: String(dayCount), description: 'Trois jours de rencontres au coeur de Morelia.' },
		]}
	/>

	<About lang="fr" />

	<ConferenceList
		heading="Conferences"
		limit={3}
		viewAllHref="/fr/conferences"
	/>

</PageLayout>
