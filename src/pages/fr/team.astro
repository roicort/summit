---
import PageLayout from '../../layouts/PageLayout.astro';
import Card from '../../components/Card.astro';
import { getCollection } from 'astro:content';

const authorsEntries = (await getCollection('authors')).filter((entry) => entry.id.startsWith('fr/'));
const team = authorsEntries.map((entry) => entry.data);
---

<PageLayout
	title="Équipe"
	description="Les personnes qui donnent vie aux conversations climat de Summit a Mexico."
	eyebrow="Equipe Summit"
>
	<section class="content-shell py-12 space-y-8">
		<header class="space-y-3 max-w-3xl">
			<p class="text-xs uppercase tracking-[0.3em] text-subtle">Organisateurs</p>
			<h1 class="text-3xl sm:text-4xl font-semibold leading-tight text-ink">Rencontrez les personnes derrière Summit</h1>
			<p class="text-base text-muted">
				Une petite équipe qui réunit science, savoirs locaux et action climatique concrète.
			</p>
		</header>

		<div class="grid gap-6 md:grid-cols-3">
			{team.map((person) => (
				<Card
					title={person.name}
					eyebrow={person.role}
					description={person.bio}
					image={person.avatar}
					imageAlt={person.name}
				>
					<div class="mt-3 space-y-1 text-sm text-subtle">
						{person.location && <p class="m-0 font-medium text-muted">{person.location}</p>}
						{person.focus && <p class="m-0">{person.focus}</p>}
					</div>
				</Card>
			))}
		</div>
	</section>
</PageLayout>
